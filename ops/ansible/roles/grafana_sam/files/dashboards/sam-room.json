         "type": "row"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "Click a hostname to drill into that device.",
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "align": "auto",
                  "cellOptions": {
                     "type": "auto"
                  },
                  "filterable": true
               }
            },
            "overrides": [
               {
                  "matcher": {
                     "id": "byName",
                     "options": "State"
                  },
                  "properties": [
                     {
                        "id": "mappings",
                        "value": [
                           {
                              "options": {
                                 "0": {
                                    "color": "red",
                                    "index": 1,
                                    "text": "Not reporting"
                                 },
                                 "1": {
                                    "color": "green",
                                    "index": 0,
                                    "text": "Reporting"
                                 },
                                 "2": {
                                    "color": "blue",
                                    "index": 2,
                                    "text": "Maintenance"
                                 }
                              },
                              "type": "value"
                           },
                           {
                              "options": {
                                 "match": "null",
                                 "result": {
                                    "color": "orange",
                                    "index": 3,
                                    "text": "Never scraped"
                                 }
                              },
                              "type": "special"
                           }
                        ]
                     },
                     {
                        "id": "custom.cellOptions",
                        "value": {
                           "type": "color-text"
                        }
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "Hostname"
                  },
                  "properties": [
                     {
                        "id": "links",
                        "value": [
                           {
                              "targetBlank": false,
                              "title": "Device detail",
                              "url": "/d/sam-device/device?var-hostname=${__value.text}"
                           }
                        ]
                     }
                  ]
               }
            ]
         },
         "gridPos": {
            "h": 12,
            "w": 24,
            "x": 0,
            "y": 5
         },
         "id": 8,
         "options": {
            "cellHeight": "sm",
            "footer": {
               "countRows": false,
               "fields": "",
               "reducer": [
                  "sum"
               ],
               "show": false
            },
            "showHeader": true,
            "sortBy": [ ]
         },
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "editorMode": "code",
               "expr": "sum by (sam_hostname, sam_asset_type, sam_manufacturer, sam_model, sam_criticality) (sam_asset_info{sam_fi_number=\"$fi_number\"})",
               "format": "table",
               "instant": true,
               "legendFormat": "",
               "range": false,
               "refId": "A"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "editorMode": "code",
               "expr": "max by (sam_hostname) (probe_success{sam_fi_number=\"$fi_number\"})\nor\n(sam_asset_maintenance and on (sam_hostname) sam_asset_info{sam_fi_number=\"$fi_number\"}) * 2\n",
               "format": "table",
               "instant": true,
               "legendFormat": "",
               "range": false,
               "refId": "B"
            }
         ],
         "title": "Devices in this room",
         "transformations": [
            {
               "id": "joinByField",
               "options": {
                  "byField": "sam_hostname",
                  "mode": "outer"
               }
            },
            {
               "id": "organize",
               "options": {
                  "excludeByName": {
                     "Time": true,
                     "Time 1": true,
                     "Time 2": true,
                     "Value #A": true,
                     "__name__": true,
                     "__name__ 1": true,
                     "__name__ 2": true
                  },
                  "indexByName": {
                     "Value #B": 1,
                     "sam_asset_type": 2,
                     "sam_criticality": 5,
                     "sam_hostname": 0,
                     "sam_manufacturer": 3,
                     "sam_model": 4
                  },
                  "renameByName": {
                     "Value #B": "State",
                     "sam_asset_type": "Type",
                     "sam_criticality": "Criticality",
                     "sam_hostname": "Hostname",
                     "sam_manufacturer": "Manufacturer",
                     "sam_model": "Model"
                  }
               }
            }
         ],
         "type": "table"
      },
