// SAM - Simple Asset Management
// Prisma schema for MySQL

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?  // null for SSO-only users
  provider     String   @default("credentials") // "credentials" | "microsoft-entra-id"
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attachments Attachment[]

  @@map("users")
}

model Location {
  id             String   @id @default(cuid())
  name           String
  description    String?  @db.Text
  parentId       String?
  order          Int      @default(0)
  // Facility identifier, e.g. "14.10.100.013"
  // Segments: CC.BB.FFF.RRR  (campus.building.floor.room)
  fiNumber       String?  @unique
  // Address fields
  address        String?
  city           String?
  country        String?
  latitude       Float?
  longitude      Float?
  // Cover image: references an Attachment id (image)
  coverImageId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent      Location?    @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Location[]   @relation("LocationTree")
  assets      Asset[]
  attachments Attachment[]

  @@index([parentId])
  @@map("locations")
}

model AssetType {
  id        String   @id @default(cuid())
  name      String   @unique
  // Prometheus scrape target template (newline-separated key=value pairs).
  // Keys are Prometheus __labels__ (e.g. __address__, __metrics_path__, __param_*).
  // Values may contain {hostname_fqdn}, {serial}, {model}, {manufacturer},
  // {fi_number}, and {vault_<key>} placeholders.
  // Example for Pearl recorder exporter:
  //   __address__=https://pearlexporterdev.ugent.be
  //   __metrics_path__=/probe
  //   __param_target__=https://{hostname_fqdn}
  //   __param_user__={vault_username}
  //   __param_password__={vault_password}
  scrapeTargetTemplate String? @db.Text
  createdAt            DateTime @default(now())

  assets Asset[]

  @@map("asset_types")
}

model Manufacturer {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  assets Asset[]

  @@map("manufacturers")
}

model Asset {
  id               String    @id @default(cuid())
  locationId       String
  typeId           String?
  manufacturerId   String?
  model            String?
  serialNumber     String?
  hostname         String?
  installationDate DateTime? @db.Date
  invoiceNumber    String?
  invoiceDate      DateTime? @db.Date
  notes            String?   @db.Text
  // Optional path to a HashiCorp Vault KV secret containing per-device
  // credentials (e.g. "secret/data/av/rectest001").
  // Used by the Prometheus SD endpoint to inject {vault_<key>} placeholders.
  vaultPath        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  type         AssetType?   @relation(fields: [typeId], references: [id])
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id])
  macAddresses MacAddress[]
  customFields CustomField[]
  attachments  Attachment[]

  @@index([locationId])
  @@index([typeId])
  @@index([manufacturerId])
  @@map("assets")
}

model MacAddress {
  id      String @id @default(cuid())
  assetId String
  address String

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("mac_addresses")
}

model CustomField {
  id      String @id @default(cuid())
  assetId String
  key     String
  value   String @db.Text

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("custom_fields")
}

model Attachment {
  id           String   @id @default(cuid())
  filename     String   // stored filename on disk
  originalName String   // original upload filename
  mimeType     String
  size         Int
  path         String   // relative path under /uploads
  locationId   String?
  assetId      String?
  uploadedById String
  createdAt    DateTime @default(now())

  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  asset      Asset?    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id])

  @@index([locationId])
  @@index([assetId])
  @@map("attachments")
}
