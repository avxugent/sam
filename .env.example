# ─── Database ─────────────────────────────────────────────────────────────────
# Individual MySQL connection parameters.
# The application constructs the connection URL from these at startup — never
# store a pre-assembled URL with embedded credentials.
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="samdb"
DB_USER="sam"
DB_PASSWORD="change-sam-password"
# Set to "true" to require TLS (sslaccept=strict). Recommended for production
# deployments where the database is on a separate host.
DB_SSL="false"

# ─── Next Auth ────────────────────────────────────────────────────────────────
# REQUIRED: generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-long-random-secret"

# Full public URL of this deployment (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ─── File Uploads ─────────────────────────────────────────────────────────────
# Directory for uploaded files (relative to project root, or absolute path)
UPLOAD_DIR="./uploads"

# ─── Microsoft Entra ID SSO (optional) ───────────────────────────────────────
# Leave all three blank to disable SSO and show only local login.
# Register a "Web" platform app in Entra ID with redirect URI:
#   https://<your-domain>/api/auth/callback/microsoft-entra-id
#
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Format: https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# ─── CSV Export (optional) ───────────────────────────────────────────────────
# Bearer token for the /api/export/csv endpoint — allows external cron jobs to
# download exports without a browser session.
# Generate with: openssl rand -base64 32
EXPORT_TOKEN=""

# ─── Prometheus / Monitoring Integration (optional) ──────────────────────────
# Static bearer token that Prometheus and Grafana use to authenticate against
# the /api/prometheus/* endpoints.
# Generate with: openssl rand -base64 32
# Leave blank to disable the endpoints (they return 503 when not set).
PROMETHEUS_SD_TOKEN=""

# ─── HashiCorp Vault (optional) ───────────────────────────────────────────────
# Required only when assets use {vault_*} placeholders in their scrape template.
# SAM reads per-device credentials from Vault at Prometheus SD time.
#
# VAULT_ADDR       — Vault server URL, e.g. https://vault.example.com
# VAULT_KV_VERSION — "v1" or "v2" (default: v2)
#
# Authentication — choose one method:
#
#   Token auth (simpler, suitable for static long-lived tokens):
#     VAULT_TOKEN — static token with read access to all asset secret paths
#
#   AppRole auth (recommended for production — no long-lived token in config):
#     VAULT_ROLE_ID       — AppRole role_id
#     VAULT_SECRET_ID     — AppRole secret_id
#     VAULT_APPROLE_MOUNT — auth mount path (default: "approle")
#
# When both VAULT_TOKEN and the AppRole vars are set, AppRole takes precedence.
VAULT_ADDR=""
VAULT_KV_VERSION="v2"
# Token auth
VAULT_TOKEN=""
# AppRole auth
VAULT_ROLE_ID=""
VAULT_SECRET_ID=""
VAULT_APPROLE_MOUNT="approle"

# ─── Storage backend ──────────────────────────────────────────────────────────
# "local" (default) or "s3". When "s3", all attachment uploads and the CSV
# backup script write to S3 instead of disk. Local mode reads UPLOAD_DIR.
STORAGE_DRIVER=""

# Required when STORAGE_DRIVER=s3
S3_BUCKET=""
S3_REGION="us-east-1"

# Optional — set for S3-compatible providers (MinIO, Cloudflare R2,
# Backblaze B2, Wasabi, OVH).
S3_ENDPOINT=""           # e.g. https://s3.eu-west-1.amazonaws.com or http://minio:9000
S3_FORCE_PATH_STYLE=""   # "true" for MinIO / R2

# Standard AWS credential chain is used. Set these only if you don't have
# instance / pod credentials available:
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Object-key prefix for the daily CSV backup (used by scripts/export-backup.mjs
# when STORAGE_DRIVER=s3).
EXPORT_S3_PREFIX="backups/"

# ─── Audit-log forwarding to rsyslog (optional) ───────────────────────────────
# When SYSLOG_HOST is set, every AuditLog write is also forwarded to the
# configured rsyslog server using RFC 5424. Successful forwards mark the row
# in the database; failed ones are picked up by `scripts/forward-audit.mjs`
# (run via cron) so that the rsyslog destination converges with the DB.
SYSLOG_HOST=""                       # e.g. logs.example.com (unset → forwarding disabled)
SYSLOG_PORT=""                       # default 514 (udp/tcp) or 6514 (tls)
SYSLOG_TRANSPORT="udp"               # udp | tcp | tls
SYSLOG_APP_NAME="sam"                # APP-NAME field
SYSLOG_HOSTNAME=""                   # HOSTNAME field; defaults to os.hostname()
SYSLOG_FACILITY="10"                 # 10 = security/auth; 16-23 = local0..local7
SYSLOG_TIMEOUT_MS="3000"             # connect/send timeout in ms
SYSLOG_CA_BUNDLE=""                  # TLS only — path to CA bundle PEM
SYSLOG_TLS_REJECT_UNAUTHORIZED="true"  # TLS only — set "false" for self-signed (dev)

# ─── Atlassian JIRA (optional, read-only integration) ─────────────────────────
# When all three are set, work-log entries with a JIRA issue key (e.g. "AVT-123")
# fetch and display the issue summary + status from JIRA.
# Generate an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=""
JIRA_EMAIL=""
JIRA_API_TOKEN=""

# ─── Docker Compose ───────────────────────────────────────────────────────────
# MySQL root password (used by the db container only, not the app)
MYSQL_ROOT_PASSWORD="change-root-password"

# Port the app container is exposed on (default: 3000)
APP_PORT=3000
# Port the DB container is exposed on (default: 3306; remove DB port mapping in prod)
DB_PORT=3306
