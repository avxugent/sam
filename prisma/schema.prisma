// SAM - Simple Asset Management
// Prisma schema for MySQL

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum AssetStatus {
  INSTALLED
  DECOMMISSIONED
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DisposalMethod {
  WIPED
  DESTROYED
  RETURNED
  RESOLD
  OTHER
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String? // null for SSO-only users
  provider           String    @default("credentials") // "credentials" | "microsoft-entra-id"
  role               Role      @default(VIEWER)
  // TOTP-based two-factor authentication (credentials users only)
  totpSecret         String? // base32-encoded secret; null = 2FA not set up
  totpEnabled        Boolean   @default(false) // true only after user has verified first code
  // Forced enrollment flags (set by admin)
  mustChangePassword Boolean   @default(false) // cleared after user successfully changes password
  twoFactorRequired  Boolean   @default(false) // stays set; forces 2FA setup on next login
  // UI preference: which tab opens first when navigating to a location with sub-locations
  locationDefaultTab String    @default("assets") // "assets" | "sublocations"
  // UI preference: colour scheme
  theme              String    @default("light") // "light" | "dark" | "system"
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  attachments Attachment[]
  workLogs    WorkLog[]    @relation("WorkLogPerformer")
  passkeys    Passkey[]

  @@map("users")
}

// WebAuthn passkey — an alternative second factor to TOTP. Hand-rolled with
// @simplewebauthn/server (no NextAuth Adapter is used anywhere in this app).
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  credentialId String    @unique // base64url, from response.id/rawId
  publicKey    String    @db.Text // base64url-encoded COSE public key
  counter      Int       @default(0) // WebAuthn signature counter
  transports   String? // JSON-stringified string[] (e.g. ["internal","hybrid"])
  deviceType   String // "singleDevice" | "multiDevice"
  backedUp     Boolean   @default(false)

  label        String // user-facing name, e.g. "Work laptop"
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@map("passkeys")
}

model Location {
  id            String   @id @default(cuid())
  name          String
  description   String?  @db.Text
  parentId      String?
  order         Int      @default(0)
  // Facility identifier, e.g. "14.10.100.013"
  // Segments: CC.BB.FFF.RRR  (campus.building.floor.room)
  fiNumber      String?  @unique
  // Address fields
  address       String?
  city          String?
  country       String?
  latitude      Float?
  longitude     Float?
  // Cover image: references an Attachment id (image)
  coverImageId  String?
  // When true, assets in this room are excluded from Prometheus service
  // discovery. Only rooms (leaf locations) may be placed in maintenance.
  inMaintenance Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent      Location?    @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Location[]   @relation("LocationTree")
  assets      Asset[]
  attachments Attachment[]
  workLogs    WorkLog[]
  stockItems  StockItem[]

  @@index([parentId])
  @@map("locations")
}

model AssetType {
  id                   String       @id @default(cuid())
  name                 String       @unique
  // Prometheus scrape target template (newline-separated key=value pairs).
  // This is the default template for the type. Overrides, most specific wins:
  //   AssetTypeModelTemplate (this type + manufacturer + model) →
  //   AssetTypeManufacturerTemplate (this type + manufacturer) →
  //   this default.
  // Keys are Prometheus __labels__ (e.g. __address__, __metrics_path__, __param_*).
  // Values may contain {hostname_fqdn}, {serial}, {model}, {manufacturer},
  // {fi_number}, and {vault_path} placeholders. {vault_path} is a non-secret
  // reference; credentials are never rendered into SD output, and there is no
  // {vault_<key>} substitution.
  // Query-string params use __param_<name> (no trailing underscore) —
  // __param_target__ would produce a param literally named "target__".
  // Example for Pearl recorder exporter:
  //   __address__=https://pearlexporterdev.ugent.be
  //   __metrics_path__=/probe
  //   __param_target=https://{hostname_fqdn}
  //   __param_vault_path={vault_path}
  scrapeTargetTemplate String?      @db.Text
  prometheusExposed    Boolean      @default(true)
  // Optional regex (JS RegExp syntax) that a hostname must match for assets
  // of this type. Tested case-insensitively; not auto-anchored, so the admin
  // controls whether ^/$ are required for an exact match. When null, assets
  // of this type fall back to the generic FQDN check.
  hostnamePattern      String?      @db.VarChar(500)
  // Default criticality for assets of this type; per-asset override wins.
  defaultCriticality   Criticality?
  createdAt            DateTime     @default(now())

  assets                Asset[]
  stockItems            StockItem[]
  presets               MaintenancePreset[]
  manufacturerTemplates AssetTypeManufacturerTemplate[]
  modelTemplates        AssetTypeModelTemplate[]

  @@map("asset_types")
}

model Manufacturer {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  assets         Asset[]
  stockItems     StockItem[]
  typeTemplates  AssetTypeManufacturerTemplate[]
  modelTemplates AssetTypeModelTemplate[]

  @@map("manufacturers")
}

// Per-(AssetType, Manufacturer) override of AssetType.scrapeTargetTemplate.
// Lets brands under the same asset type that expose metrics differently
// (different exporter/endpoint) get their own template. Resolution order in
// the SD endpoint: AssetTypeModelTemplate → this override (matched on the
// asset's manufacturerId) → AssetType.scrapeTargetTemplate → no template.
model AssetTypeManufacturerTemplate {
  id                   String   @id @default(cuid())
  typeId               String
  manufacturerId       String
  scrapeTargetTemplate String   @db.Text
  createdAt            DateTime @default(now())

  type         AssetType    @relation(fields: [typeId], references: [id], onDelete: Cascade)
  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)

  @@unique([typeId, manufacturerId])
  @@index([manufacturerId])
  @@map("asset_type_manufacturer_templates")
}

// Per-(AssetType, Manufacturer, Model) override — the most specific tier.
// `model` is matched against Asset.model case-insensitively (trimmed), since
// model is a free-text field rather than a lookup table. Lets a single brand
// under one asset type expose different models through different
// exporters/endpoints. Resolution order in the SD endpoint: this override
// (matched on the asset's manufacturerId + model) →
// AssetTypeManufacturerTemplate → AssetType.scrapeTargetTemplate → no template.
model AssetTypeModelTemplate {
  id                   String   @id @default(cuid())
  typeId               String
  manufacturerId       String
  model                String   @db.VarChar(255)
  scrapeTargetTemplate String   @db.Text
  createdAt            DateTime @default(now())

  type         AssetType    @relation(fields: [typeId], references: [id], onDelete: Cascade)
  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)

  @@unique([typeId, manufacturerId, model])
  @@index([manufacturerId])
  @@map("asset_type_model_templates")
}

model Supplier {
  id                String    @id @default(cuid())
  name              String    @unique
  contractReference String?   @db.VarChar(255)
  contactInfo       String?   @db.Text
  // Default window: assets created while today is within [defaultFrom,
  // defaultUntil] and without an explicit supplier are assigned this one.
  // defaultFrom null = window inactive; defaultUntil null = open-ended.
  defaultFrom       DateTime? @db.Date
  defaultUntil      DateTime? @db.Date
  createdAt         DateTime  @default(now())

  assets Asset[]

  @@map("suppliers")
}

model Asset {
  id                   String          @id @default(cuid())
  locationId           String
  typeId               String?
  manufacturerId       String?
  model                String?
  serialNumber         String?
  // Globally unique across all assets regardless of status, so a
  // decommissioned asset's hostname is never reassigned (audit trail).
  hostname             String?         @unique
  // Number of physical units this row represents. Only meaningful for
  // bulk items with no individual identity (e.g. speakers, batteries) —
  // locked to 1 whenever serialNumber or hostname is set.
  quantity             Int             @default(1)
  installationDate     DateTime?       @db.Date
  invoiceNumber        String?
  invoiceDate          DateTime?       @db.Date
  warrantyMonths       Int?
  notes                String?         @db.Text
  // Optional path to a HashiCorp Vault KV secret containing per-device
  // credentials (e.g. "secret/data/av/rectest001").
  // Emitted by the Prometheus SD endpoint as the {vault_path} reference. SAM
  // never reads the secret; the exporter resolves it from Vault at scrape time.
  vaultPath            String?
  // Responsible person; soft ref to User (no FK) so it survives user deletion.
  ownerId              String?
  // null = inherit AssetType.defaultCriticality
  criticality          Criticality?
  endOfSupportDate     DateTime?       @db.Date
  supplierId           String?
  status               AssetStatus     @default(INSTALLED)
  decommissionedAt     DateTime?
  decommissionNote     String?         @db.VarChar(500)
  disposalMethod       DisposalMethod?
  // Soft ref to User (no FK), survives user deletion.
  decommissionedById   String?
  lastLocationName     String?         @db.VarChar(255)
  lastLocationFiNumber String?         @db.VarChar(20)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  type         AssetType?    @relation(fields: [typeId], references: [id])
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id])
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  macAddresses MacAddress[]
  customFields CustomField[]
  attachments  Attachment[]
  workLogs     WorkLog[]

  @@index([locationId])
  @@index([typeId])
  @@index([manufacturerId])
  @@index([installationDate])
  @@index([supplierId])
  @@index([endOfSupportDate])
  @@index([ownerId])
  @@map("assets")
}

model MacAddress {
  id      String @id @default(cuid())
  assetId String
  address String

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("mac_addresses")
}

model CustomField {
  id      String @id @default(cuid())
  assetId String
  key     String
  value   String @db.Text

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("custom_fields")
}

model Attachment {
  id             String   @id @default(cuid())
  attachmentType String   @default("file") // "file" | "link"
  filename       String? // null for link attachments
  originalName   String // file original name OR link display label
  displayName    String? // user-editable display name; null = fall back to originalName
  description    String?  @db.Text
  mimeType       String? // null for link attachments
  size           Int? // null for link attachments
  path           String? // null for link attachments
  url            String?  @db.Text // set for link attachments
  locationId     String?
  assetId        String?
  uploadedById   String
  createdAt      DateTime @default(now())

  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  asset      Asset?    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id])

  @@index([locationId])
  @@index([assetId])
  @@map("attachments")
}

model AuditLog {
  id          String    @id @default(cuid())
  timestamp   DateTime  @default(now())
  userId      String?
  userEmail   String?
  action      String // CREATE | UPDATE | DELETE | IMPORT | EXPORT
  entityType  String // Asset | Location | User | AssetType | Manufacturer | Attachment
  entityId    String?
  entityName  String?
  detail      String?   @db.Text // JSON
  ipAddress   String?
  userAgent   String?
  // Set after the row is successfully forwarded to the configured syslog
  // server. NULL = not yet forwarded (eligible for the catch-up job).
  forwardedAt DateTime?

  @@index([timestamp])
  @@index([userId])
  @@index([entityType])
  @@index([forwardedAt])
  @@map("audit_logs")
}

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model Report {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  definition  String   @db.Text // JSON-encoded ReportDefinition
  createdById String? // soft ref — no FK, survives user deletion
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reports")
}

model WorkLog {
  id            String   @id @default(cuid())
  locationId    String
  assetId       String? // optional — null for location-wide work
  itemId        String? // optional — fixed work-log item (e.g. "Review asset list")
  performedById String // user who performed the work
  performedAt   DateTime @db.Date // when the work was done
  description   String   @db.Text
  jiraIssueKey  String?  @db.VarChar(64)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  location    Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  asset       Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  item        WorkLogItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  performedBy User         @relation("WorkLogPerformer", fields: [performedById], references: [id])

  @@index([locationId])
  @@index([assetId])
  @@index([itemId])
  @@index([performedById])
  @@index([performedAt])
  @@map("work_logs")
}

// Fixed, admin-defined work-log items (e.g. "Review asset list").
// Selecting one on a work-log entry lets a location be tracked/reported
// as having that recurring task done.
model WorkLogItem {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  workLogs WorkLog[]

  @@map("work_log_items")
}

model MaintenancePreset {
  id          String   @id @default(cuid())
  assetTypeId String
  name        String   @db.VarChar(120)
  description String?  @db.Text
  createdAt   DateTime @default(now())

  assetType AssetType @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)

  @@index([assetTypeId])
  @@map("maintenance_presets")
}

model StockItem {
  id                    String    @id @default(cuid())
  typeId                String
  manufacturerId        String?
  model                 String    @db.VarChar(255)
  serialNumber          String?   @db.VarChar(100)
  quantity              Int       @default(1)
  notes                 String?   @db.Text
  // Physical storage location: where the stock currently sits (a Location
  // in the same tree used for assets, e.g. a storage room). Distinct from
  // reservedForLocationId (where a unit is earmarked to be deployed).
  locationId            String?
  reservedForLocationId String?
  invoiceNumber         String?   @db.VarChar(100)
  invoiceDate           DateTime? @db.Date
  // JSON blob preserving item-specific data when an asset is returned to stock
  // Shape: { macAddresses?: {address:string}[], customFields?: {key:string,value:string}[], hostname?: string, warrantyMonths?: number, vaultPath?: string }
  metadata              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  type         AssetType     @relation(fields: [typeId], references: [id])
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id])
  location     Location?     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([typeId])
  @@index([manufacturerId])
  @@index([locationId])
  @@map("stock_items")
}
