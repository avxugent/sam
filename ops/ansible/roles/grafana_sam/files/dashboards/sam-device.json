      {
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "description": "",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "fixed"
               },
               "decimals": 0,
               "mappings": [
                  {
                     "options": {
                        "0": {
                           "color": "red",
                           "index": 1,
                           "text": "Not reporting"
                        },
                        "1": {
                           "color": "green",
                           "index": 0,
                           "text": "Reporting"
                        },
                        "2": {
                           "color": "blue",
                           "index": 2,
                           "text": "Maintenance"
                        }
                     },
                     "type": "value"
                  },
                  {
                     "options": {
                        "match": "null",
                        "result": {
                           "color": "orange",
                           "index": 3,
                           "text": "Never scraped"
                        }
                     },
                     "type": "special"
                  }
               ],
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "text",
                        "value": null
                     }
                  ]
               },
               "unit": "short"
            },
            "overrides": [ ]
