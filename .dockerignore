# Dependencies (will be installed fresh in container)
node_modules
npm-debug.log*

# Next.js build output
.next
out

# Git
.git
.gitignore

# Environment files (secrets must NOT be baked into the image)
.env
.env.*
!.env.example

# Uploaded files (must be mounted as a volume)
uploads/

# Dev / editor artifacts
.DS_Store
*.tsbuildinfo
.vscode
# Local agent settings and skills must never reach the image or the build cache
.claude
.idea

# Docs
README.md
AGENTS.md
CLAUDE.md

# Docker files themselves
Dockerfile*
docker-compose*
scripts/node_modules
