            {
               "id": "joinByField",
               "options": {
                  "byField": "sam_fi_number",
                  "mode": "outer"
               }
            },
            {
               "id": "organize",
               "options": {
                  "excludeByName": {
                     "Time": true,
                     "Time 1": true,
                     "Time 2": true,
                     "Time 3": true,
                     "Time 4": true,
                     "__name__": true,
                     "__name__ 1": true,
                     "__name__ 2": true,
                     "__name__ 3": true,
                     "__name__ 4": true
                  },
                  "indexByName": {
                     "Value #A": 7,
                     "Value #B": 6,
                     "Value #C": 4,
                     "Value #D": 5,
                     "sam_building": 3,
                     "sam_campus": 2,
                     "sam_fi_number": 0,
                     "sam_location_name": 1
                  },
                  "renameByName": {
                     "Value #A": "Expected",
                     "Value #B": "Reporting",
                     "Value #C": "Not reporting",
                     "Value #D": "Never scraped",
                     "sam_building": "Building",
                     "sam_campus": "Campus",
                     "sam_fi_number": "FI number",
                     "sam_location_name": "Room"
                  }
               }
            }
         ],
