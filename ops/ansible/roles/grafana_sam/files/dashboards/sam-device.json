               "editorMode": "code",
               "expr": "max by (sam_hostname) (probe_success{sam_hostname=\"$hostname\"})\nor\n(sam_asset_maintenance and on (sam_hostname) sam_asset_info{sam_hostname=\"$hostname\"}) * 2\n",
