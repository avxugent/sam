            "defaults": {
               "custom": {
                  "align": "auto",
                  "cellOptions": {
                     "type": "auto"
                  },
                  "filterable": true
               },
               "noValue": "0"
            },
            "overrides": [
               {
                  "matcher": {
                     "id": "byName",
                     "options": "FI number"
                  },
                  "properties": [
                     {
                        "id": "links",
                        "value": [
