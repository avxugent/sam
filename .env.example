# ─── Database ─────────────────────────────────────────────────────────────────
# Connection string for MySQL/MariaDB
DATABASE_URL="mysql://sam:sampassword@localhost:3306/samdb"

# ─── Next Auth ────────────────────────────────────────────────────────────────
# REQUIRED: generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-long-random-secret"

# Full public URL of this deployment (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ─── File Uploads ─────────────────────────────────────────────────────────────
# Directory for uploaded files (relative to project root, or absolute path)
UPLOAD_DIR="./uploads"

# ─── Microsoft Entra ID SSO (optional) ───────────────────────────────────────
# Leave all three blank to disable SSO and show only local login.
# Register a "Web" platform app in Entra ID with redirect URI:
#   https://<your-domain>/api/auth/callback/microsoft-entra-id
#
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Format: https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# ─── Prometheus / Monitoring Integration (optional) ──────────────────────────
# Static bearer token that Prometheus and Grafana use to authenticate against
# the /api/prometheus/* endpoints.
# Generate with: openssl rand -base64 32
# Leave blank to disable the endpoints (they return 503 when not set).
PROMETHEUS_SD_TOKEN=""

# ─── HashiCorp Vault (optional) ───────────────────────────────────────────────
# Required only when assets use {vault_*} placeholders in their scrape template.
# SAM reads per-device credentials from Vault at Prometheus SD time.
#
# VAULT_ADDR    — Vault server URL, e.g. https://vault.example.com
# VAULT_TOKEN   — Static token with read access to all asset secret paths
# VAULT_KV_VERSION — "v1" or "v2" (default: v2)
VAULT_ADDR=""
VAULT_TOKEN=""
VAULT_KV_VERSION="v2"

# Database credentials
MYSQL_ROOT_PASSWORD="change-root-password"
MYSQL_PASSWORD="change-sam-password"

# Port the app container is exposed on (default: 3000)
APP_PORT=3000
# Port the DB container is exposed on (default: 3306; remove DB port mapping in prod)
DB_PORT=3306
