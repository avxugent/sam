{
  "name": "sam",
  "version": "4.1.2",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:clear-import": "node --import tsx/esm scripts/clear-import-data.mjs",
    "db:clear-import:force": "node --import tsx/esm scripts/clear-import-data.mjs --force",
    "locations:add-links": "node --import tsx/esm scripts/add-location-links.mjs",
    "locations:add-links:dry-run": "node --import tsx/esm scripts/add-location-links.mjs --dry-run",
    "locations:sync-lokalen": "node --import tsx/esm scripts/sync-lokalen.mjs",
    "locations:sync-lokalen:dry-run": "node --import tsx/esm scripts/sync-lokalen.mjs --dry-run",
    "attachment:add": "node --import tsx/esm scripts/add-attachment.mjs",
    "assets:resolve-hostnames": "node --import tsx/esm scripts/resolve-ip-hostnames.mjs",
    "assets:resolve-hostnames:dry-run": "node --import tsx/esm scripts/resolve-ip-hostnames.mjs --dry-run",
    "assets:fix-serial-numbers": "node --import tsx/esm scripts/fix-scientific-notation-serials.mjs",
    "assets:fix-serial-numbers:dry-run": "node --import tsx/esm scripts/fix-scientific-notation-serials.mjs --dry-run",
    "assets:fix-mac-format": "node --import tsx/esm scripts/fix-mac-address-format.mjs",
    "assets:fix-mac-format:dry-run": "node --import tsx/esm scripts/fix-mac-address-format.mjs --dry-run",
    "assets:migrate-quantity": "node --import tsx/esm scripts/migrate-quantity-custom-field.mjs",
    "assets:migrate-quantity:dry-run": "node --import tsx/esm scripts/migrate-quantity-custom-field.mjs --dry-run",
    "export:backup": "node --import tsx/esm scripts/export-backup.mjs",
    "export:backup:dry-run": "node --import tsx/esm scripts/export-backup.mjs --dry-run",
    "user:reset-password": "node --import tsx/esm scripts/reset-password.mjs",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:integration": "RUN_DB_TESTS=1 vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@hookform/resolvers": "^5.9.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastest-levenshtein": "^1.0.16",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "postcss": ">=8.5.10",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^31.0.0",
    "msw": "^3.0.4",
    "node-html-parser": "9.0.4",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
